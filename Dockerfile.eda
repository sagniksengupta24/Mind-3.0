FROM python:3.11-slim

ARG OSS_CAD_SUITE_TAG=2026-09-29
ENV MIND3_EDA_READONLY_PATHS=/opt/oss-cad-suite
ENV PATH=/opt/oss-cad-suite/bin:${PATH}

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl bubblewrap \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install --no-cache-dir '.[dev]'

COPY tools/install_oss_cad_suite.py ./tools/install_oss_cad_suite.py
RUN python tools/install_oss_cad_suite.py --tag "${OSS_CAD_SUITE_TAG}" --destination /opt/oss-cad-suite

COPY . .
CMD ["pytest", "-q", "-m", "not eda"]
