 class VerificationHarnessGenerator:
     """Generates formal SBY configuration, SVA bind files, and Verilator C++ stimulus without viewing RTL internals."""
 
+    @staticmethod
+    def _has_clock(contract: InterfaceContract) -> bool:
+        """Check if contract has a clock port."""
+        return any("clk" in p.name.lower() for p in contract.ports if p.direction == PortDirection.INPUT)
+
+    @staticmethod
+    def _get_clock_name(contract: InterfaceContract) -> str:
+        """Get the clock signal name from contract ports."""
+        for p in contract.ports:
+            if p.direction == PortDirection.INPUT and "clk" in p.name.lower():
+                return p.name
+        return "clk"  # fallback
+
+    @staticmethod
+    def _has_reset(contract: InterfaceContract) -> bool:
+        """Check if contract has a reset port."""
+        return any("rst" in p.name.lower() for p in contract.ports if p.direction == PortDirection.INPUT)
+
+    @staticmethod
+    def _get_reset_name(contract: InterfaceContract) -> str:
+        """Get the reset signal name from contract ports."""
+        for p in contract.ports:
+            if p.direction == PortDirection.INPUT and "rst" in p.name.lower():
+                return p.name
+        return "rst_n"  # fallback
+
+    @staticmethod
+    def _is_temporal_expression(expr: str) -> bool:
+        """Check if SVA expression contains temporal operators not supported in always-block assertions."""
+        # Only truly temporal operators that Yosys formal doesn't support in procedural assertions
+        # Note: bare '->' is often logical implication in expression context, not temporal
+        # $onehot0, $onehot, $countones are combinational, not temporal
+        temporal_patterns = [
+            r"\|\->",           # overlapping implication (always temporal)
+            r"\|=>",            # non-overlapping implication (always temporal)
+            r"\#\#",            # delay
+            r"\bsequence\b",    # sequence keyword
+            r"\bproperty\b",    # property keyword
+            r"\$\w+\(",         # system functions like $rose, $fell, $stable, $past
+        ]
+        import re
+        for pattern in temporal_patterns:
+            if re.search(pattern, expr):
+                # Exclude known combinational system functions
+                if re.search(r"\$(onehot0|onehot|countones)\(", expr):
+                    continue
+                return True
+        return False
+
